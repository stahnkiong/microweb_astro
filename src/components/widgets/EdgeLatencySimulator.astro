---
interface Props {
  height?: string;
}

const { height = '600px' } = Astro.props;
---

<div
  class="edge-simulator-container flex flex-col lg:flex-row gap-6 p-6 md:p-8 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-xl overflow-hidden transition-all duration-300 not-prose"
  style={`min-height: ${height};`}
>
  <!-- Interactive Controls -->
  <div class="flex-1 flex flex-col justify-between space-y-6">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-primary/10 text-primary mb-3">
        <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
        Interactive Edge Telemetry Benchmarker
      </div>
      <h3 class="text-xl font-bold text-neutral-900 dark:text-white">
        Edge Compute vs. Origin Roundtrip Simulator
      </h3>
      <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
        Configure client location, security inspection, and AI inference layers to evaluate packet transit overhead and compute costs across Borneo and global nodes.
      </p>
    </div>

    <div class="space-y-5">
      <!-- Location Routing -->
      <div class="space-y-1.5">
        <label class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
          Client Ingress Point (Borneo User)
        </label>
        <select
          id="edge-location-select"
          class="w-full p-2.5 bg-neutral-100 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 rounded-lg text-xs font-medium text-neutral-900 dark:text-white focus:outline-none focus:border-primary"
        >
          <option value="kuching">Kuching, Sarawak (Local Fiber / 4G Node)</option>
          <option value="bintulu">Bintulu / Miri (Industrial Corridor)</option>
          <option value="kk">Kota Kinabalu, Sabah (North Borneo)</option>
          <option value="kl">Kuala Lumpur (Peninsular Malaysia Origin)</option>
        </select>
      </div>

      <!-- Architecture Mode -->
      <div class="space-y-1.5">
        <label class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
          Execution Architecture
        </label>
        <div class="grid grid-cols-2 gap-2">
          <button
            type="button"
            id="btn-mode-edge"
            class="px-3 py-2 text-xs font-bold rounded-lg border border-primary bg-primary text-white transition-all shadow-sm"
          >
            Cloudflare Worker + Edge AI
          </button>
          <button
            type="button"
            id="btn-mode-monolith"
            class="px-3 py-2 text-xs font-bold rounded-lg border border-neutral-300 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 transition-all"
          >
            Central Container Monolith
          </button>
        </div>
      </div>

      <!-- Inbound Request Rate -->
      <div class="space-y-1.5">
        <div class="flex justify-between items-center text-xs font-semibold">
          <span class="text-neutral-700 dark:text-neutral-300">Inbound Request Volume (Monthly)</span>
          <span id="volume-label" class="text-primary font-mono font-bold">2,500,000 reqs</span>
        </div>
        <input
          type="range"
          id="volume-slider"
          min="100000"
          max="10000000"
          step="100000"
          value="2500000"
          class="w-full h-2 bg-neutral-200 dark:bg-neutral-700 rounded-lg appearance-none cursor-pointer accent-primary"
        />
        <div class="flex justify-between text-[10px] text-neutral-400 font-mono">
          <span>100k</span>
          <span>10M / mo</span>
        </div>
      </div>

      <!-- Webhook / AI Token Payload -->
      <div class="space-y-1.5">
        <div class="flex justify-between items-center text-xs font-semibold">
          <span class="text-neutral-700 dark:text-neutral-300">AI Context & Token Payload Size</span>
          <span id="payload-label" class="text-primary font-mono font-bold">512 Tokens (~2.3 KB)</span>
        </div>
        <input
          type="range"
          id="payload-slider"
          min="128"
          max="2048"
          step="128"
          value="512"
          class="w-full h-2 bg-neutral-200 dark:bg-neutral-700 rounded-lg appearance-none cursor-pointer accent-primary"
        />
        <div class="flex justify-between text-[10px] text-neutral-400 font-mono">
          <span>128 Tokens</span>
          <span>2048 Tokens</span>
        </div>
      </div>
    </div>

    <!-- Telemetry Baseline Note -->
    <div class="border-t border-neutral-100 dark:border-neutral-800 pt-3 text-[11px] text-neutral-400 flex items-center gap-1.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-neutral-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <span>Metrics calculated against real subsea transit (SKR1M / SEA-H2X) & V8 Isolate execution benchmarks.</span>
    </div>
  </div>

  <!-- Telemetry Output Dashboard -->
  <div class="flex-1 flex flex-col justify-between p-6 rounded-xl bg-neutral-50 dark:bg-neutral-950 border border-neutral-200 dark:border-neutral-800">
    <div class="flex items-center justify-between">
      <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-400 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse" id="edge-telemetry-dot"></span>
        Real-Time Pipeline Telemetry
      </h4>
      <span id="edge-badge-pop" class="text-[10px] font-mono font-bold bg-neutral-200 dark:bg-neutral-800 px-2 py-0.5 rounded text-neutral-600 dark:text-neutral-300">
        PoP: KUL / SIN Edge
      </span>
    </div>

    <div class="my-auto py-4 space-y-5">
      <!-- Main Metric: End-to-End Latency -->
      <div class="text-center p-4 bg-white dark:bg-neutral-900 rounded-xl border border-neutral-200/80 dark:border-neutral-800 shadow-sm">
        <span class="text-[11px] font-bold uppercase tracking-widest text-neutral-500 dark:text-neutral-400 block mb-1">
          Total API Response Latency (TTFB + Execution)
        </span>
        <div id="stat-latency" class="text-4xl font-black font-mono text-emerald-500 transition-all duration-300">
          28 ms
        </div>
        <div id="stat-latency-sub" class="text-xs font-medium text-emerald-600 dark:text-emerald-400 mt-1 flex justify-center items-center gap-2">
          <span>0ms Cold Start</span> • <span>V8 Isolate Local Exec</span>
        </div>
      </div>

      <!-- Metric Grid -->
      <div class="grid grid-cols-2 gap-3">
        <!-- Cold Start Impact -->
        <div class="p-3 bg-white dark:bg-neutral-900 rounded-lg border border-neutral-200 dark:border-neutral-800">
          <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-400 block mb-0.5">Cold Start Penalty</span>
          <div id="stat-coldstart" class="text-lg font-mono font-bold text-emerald-500">0.0 ms</div>
          <span id="stat-coldstart-desc" class="text-[10px] text-neutral-500 block mt-0.5">Zero container boot overhead</span>
        </div>

        <!-- Ingress & Security Verification -->
        <div class="p-3 bg-white dark:bg-neutral-900 rounded-lg border border-neutral-200 dark:border-neutral-800">
          <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-400 block mb-0.5">HMAC Auth & Rate Check</span>
          <div id="stat-auth-time" class="text-lg font-mono font-bold text-emerald-500">1.8 ms</div>
          <span id="stat-auth-desc" class="text-[10px] text-neutral-500 block mt-0.5">Web Crypto at nearest PoP</span>
        </div>

        <!-- Backend Private Compute Load -->
        <div class="p-3 bg-white dark:bg-neutral-900 rounded-lg border border-neutral-200 dark:border-neutral-800">
          <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-400 block mb-0.5">Core ERP Monolith Load</span>
          <div id="stat-backend-load" class="text-lg font-mono font-bold text-emerald-500">-88% Shielded</div>
          <span id="stat-backend-desc" class="text-[10px] text-neutral-500 block mt-0.5">Invalid & cached traffic dropped</span>
        </div>

        <!-- Projected Monthly Infrastructure Cost -->
        <div class="p-3 bg-white dark:bg-neutral-900 rounded-lg border border-neutral-200 dark:border-neutral-800">
          <span class="text-[10px] font-bold uppercase tracking-wider text-neutral-400 block mb-0.5">Estimated Cloud Cost</span>
          <div id="stat-cloud-cost" class="text-lg font-mono font-bold text-emerald-500">USD $12.50</div>
          <span id="stat-cost-desc" class="text-[10px] text-neutral-500 block mt-0.5">Zero idle container capacity</span>
        </div>
      </div>

      <!-- Architectural Summary Banner -->
      <div id="stat-summary-box" class="p-3 bg-emerald-500/10 border border-emerald-500/30 rounded-lg">
        <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 block mb-0.5">Architecture Assessment</span>
        <p id="stat-summary-text" class="text-xs text-neutral-700 dark:text-neutral-300 leading-normal">
          Edge topology terminates TLS and executes HMAC webhook verification at regional edge PoPs. Inbound traffic bypasses cross-sea subsea fiber latency, delivering sub-30ms execution for Borneo enterprises.
        </p>
      </div>
    </div>

    <!-- Status Bar -->
    <div class="border-t border-neutral-200 dark:border-neutral-800 pt-3 flex justify-between items-center text-xs">
      <span class="text-neutral-400 text-[11px]">Subsea Cable Transit:</span>
      <div id="transit-badge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full font-mono text-[11px] font-bold bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        Decoupled Edge Ingress
      </div>
    </div>
  </div>
</div>

<script>
  function initEdgeSimulator() {
    const locationSelect = document.getElementById('edge-location-select') as HTMLSelectElement;
    const btnEdge = document.getElementById('btn-mode-edge') as HTMLButtonElement;
    const btnMonolith = document.getElementById('btn-mode-monolith') as HTMLButtonElement;
    const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement;
    const payloadSlider = document.getElementById('payload-slider') as HTMLInputElement;

    const volumeLabel = document.getElementById('volume-label');
    const payloadLabel = document.getElementById('payload-label');

    const statLatency = document.getElementById('stat-latency');
    const statLatencySub = document.getElementById('stat-latency-sub');
    const statColdstart = document.getElementById('stat-coldstart');
    const statColdstartDesc = document.getElementById('stat-coldstart-desc');
    const statAuthTime = document.getElementById('stat-auth-time');
    const statAuthDesc = document.getElementById('stat-auth-desc');
    const statBackendLoad = document.getElementById('stat-backend-load');
    const statBackendDesc = document.getElementById('stat-backend-desc');
    const statCloudCost = document.getElementById('stat-cloud-cost');
    const statCostDesc = document.getElementById('stat-cost-desc');
    const statSummaryBox = document.getElementById('stat-summary-box');
    const statSummaryText = document.getElementById('stat-summary-text');
    const transitBadge = document.getElementById('transit-badge');
    const edgeBadgePop = document.getElementById('edge-badge-pop');
    const edgeTelemetryDot = document.getElementById('edge-telemetry-dot');

    if (!locationSelect || !btnEdge || !btnMonolith || !volumeSlider || !payloadSlider) return;

    let currentMode: 'edge' | 'monolith' = 'edge';

    function setMode(mode: 'edge' | 'monolith') {
      currentMode = mode;
      if (mode === 'edge') {
        btnEdge.className = 'px-3 py-2 text-xs font-bold rounded-lg border border-primary bg-primary text-white transition-all shadow-sm';
        btnMonolith.className = 'px-3 py-2 text-xs font-bold rounded-lg border border-neutral-300 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 transition-all';
      } else {
        btnMonolith.className = 'px-3 py-2 text-xs font-bold rounded-lg border border-amber-600 bg-amber-600 text-white transition-all shadow-sm';
        btnEdge.className = 'px-3 py-2 text-xs font-bold rounded-lg border border-neutral-300 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 transition-all';
      }
      recalculate();
    }

    btnEdge.addEventListener('click', () => setMode('edge'));
    btnMonolith.addEventListener('click', () => setMode('monolith'));

    function recalculate() {
      const location = locationSelect.value;
      const volume = parseInt(volumeSlider.value);
      const tokens = parseInt(payloadSlider.value);

      if (volumeLabel) {
        volumeLabel.textContent = `${(volume / 1000000).toFixed(2)}M reqs / mo`;
      }
      const kbSize = ((tokens * 4.5) / 1024).toFixed(1);
      if (payloadLabel) {
        payloadLabel.textContent = `${tokens} Tokens (~${kbSize} KB)`;
      }

      let transitLatency = 14;
      let crossSeaPenalty = 38;
      let popName = 'KCH Local Edge / SIN Transit';

      if (location === 'kuching') {
        transitLatency = 14;
        crossSeaPenalty = 38;
        popName = 'KCH Local Edge / SIN Transit';
      } else if (location === 'bintulu') {
        transitLatency = 20;
        crossSeaPenalty = 48;
        popName = 'MY-Borneo Corridor';
      } else if (location === 'kk') {
        transitLatency = 24;
        crossSeaPenalty = 54;
        popName = 'BKI Gateway';
      } else if (location === 'kl') {
        transitLatency = 6;
        crossSeaPenalty = 4;
        popName = 'KUL Direct Origin Core';
      }

      if (edgeBadgePop) edgeBadgePop.textContent = `Active Route: ${popName}`;

      if (currentMode === 'edge') {
        const coldStartTime = 0.0;
        const authVerificationTime = 1.4 + (tokens > 512 ? 0.8 : 0.3);
        const edgeInferenceTime = Math.round(8 + (tokens / 256) * 3);
        const totalLatency = Math.round(transitLatency + authVerificationTime + edgeInferenceTime);

        const workerCost = 5 + (volume / 1000000) * 0.30 + ((volume * tokens) / 100000000) * 0.15;

        if (statLatency) {
          statLatency.textContent = `${totalLatency} ms`;
          statLatency.className = 'text-4xl font-black font-mono text-emerald-500 transition-all duration-300';
        }
        if (statLatencySub) {
          statLatencySub.innerHTML = `<span>0ms Cold Start</span> • <span>V8 Isolate (${edgeInferenceTime}ms Exec)</span>`;
          statLatencySub.className = 'text-xs font-medium text-emerald-600 dark:text-emerald-400 mt-1 flex justify-center items-center gap-2';
        }
        if (statColdstart) {
          statColdstart.textContent = `${coldStartTime.toFixed(1)} ms`;
          statColdstart.className = 'text-lg font-mono font-bold text-emerald-500';
        }
        if (statColdstartDesc) statColdstartDesc.textContent = 'Zero container boot overhead';

        if (statAuthTime) {
          statAuthTime.textContent = `${authVerificationTime.toFixed(1)} ms`;
          statAuthTime.className = 'text-lg font-mono font-bold text-emerald-500';
        }
        if (statAuthDesc) statAuthDesc.textContent = 'Web Crypto HMAC at nearest PoP';

        if (statBackendLoad) {
          statBackendLoad.textContent = '-88% Shielded';
          statBackendLoad.className = 'text-lg font-mono font-bold text-emerald-500';
        }
        if (statBackendDesc) statBackendDesc.textContent = 'Invalid & cached calls dropped at edge';

        if (statCloudCost) {
          statCloudCost.textContent = `USD $${workerCost.toFixed(2)}`;
          statCloudCost.className = 'text-lg font-mono font-bold text-emerald-500';
        }
        if (statCostDesc) statCostDesc.textContent = 'Predictable per-request V8 billing';

        if (statSummaryBox) {
          statSummaryBox.className = 'p-3 bg-emerald-500/10 border border-emerald-500/30 rounded-lg';
        }
        if (statSummaryText) {
          statSummaryText.textContent = `Edge Workers intercept requests in ${transitLatency}ms, parse tokens and verify HMAC webhooks locally. Core ERP databases remain protected behind Cloudflare Tunnels with zero egress bandwidth charges.`;
        }
        if (transitBadge) {
          transitBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full font-mono text-[11px] font-bold bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30';
          transitBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Decoupled Edge Ingress';
        }
        if (edgeTelemetryDot) edgeTelemetryDot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse';
      } else {
        const coldStartTime = 1450;
        const authVerificationTime = 38 + (tokens > 512 ? 24 : 12);
        const containerExecutionTime = Math.round(95 + (tokens / 256) * 45);
        const totalLatency = Math.round(transitLatency + crossSeaPenalty + authVerificationTime + containerExecutionTime);

        const gigabytesTransferred = (volume * (tokens * 4.5)) / (1024 * 1024 * 1024);
        const egressCost = gigabytesTransferred * 0.09;
        const monolithCost = 140 + 32 + 25 + egressCost;

        if (statLatency) {
          statLatency.textContent = `${totalLatency} ms`;
          statLatency.className = 'text-4xl font-black font-mono text-rose-500 transition-all duration-300';
        }
        if (statLatencySub) {
          statLatencySub.innerHTML = `<span>+${coldStartTime}ms On Cold Boot</span> • <span>Full Cross-Sea Roundtrip</span>`;
          statLatencySub.className = 'text-xs font-medium text-rose-600 dark:text-rose-400 mt-1 flex justify-center items-center gap-2';
        }
        if (statColdstart) {
          statColdstart.textContent = `${coldStartTime} ms`;
          statColdstart.className = 'text-lg font-mono font-bold text-rose-500';
        }
        if (statColdstartDesc) statColdstartDesc.textContent = 'Container init & JVM/Node boot';

        if (statAuthTime) {
          statAuthTime.textContent = `${authVerificationTime} ms`;
          statAuthTime.className = 'text-lg font-mono font-bold text-rose-500';
        }
        if (statAuthDesc) statAuthDesc.textContent = 'Central compute parsing + DB auth';

        if (statBackendLoad) {
          statBackendLoad.textContent = '100% Exposed';
          statBackendLoad.className = 'text-lg font-mono font-bold text-rose-500';
        }
        if (statBackendDesc) statBackendDesc.textContent = 'All unauthenticated webhooks hit core';

        if (statCloudCost) {
          statCloudCost.textContent = `USD $${monolithCost.toFixed(2)}`;
          statCloudCost.className = 'text-lg font-mono font-bold text-rose-500';
        }
        if (statCostDesc) statCostDesc.textContent = 'Fixed nodes + NAT Gateways + Egress fees';

        if (statSummaryBox) {
          statSummaryBox.className = 'p-3 bg-rose-500/10 border border-rose-500/30 rounded-lg';
        }
        if (statSummaryText) {
          statSummaryText.textContent = `High Operational Overhead: Every packet traverses the South China Sea subsea link directly to monolithic origin servers. Cold starts and high-concurrency webhook bursts cause socket starvation and costly container autoscaling.`;
        }
        if (transitBadge) {
          transitBadge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full font-mono text-[11px] font-bold bg-rose-500/15 text-rose-600 dark:text-rose-400 border border-rose-500/30';
          transitBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Origin Bottleneck Warning';
        }
        if (edgeTelemetryDot) edgeTelemetryDot.className = 'w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping';
      }
    }

    locationSelect.addEventListener('change', recalculate);
    volumeSlider.addEventListener('input', recalculate);
    payloadSlider.addEventListener('input', recalculate);

    recalculate();
  }

  document.addEventListener('DOMContentLoaded', initEdgeSimulator);
  document.addEventListener('astro:page-load', initEdgeSimulator);
</script>
